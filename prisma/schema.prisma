generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  goal       Goal?
  tasks      Task[]
  checkIns   CheckIn[]
  materials  Material[]
  chats      Chat[]
  feedbacks  Feedback[]
}

// 考研目标
model Goal {
  id          String   @id @default(uuid())
  userId      String   @unique
  university  String   // 目标院校
  major       String   // 目标专业
  examDate    DateTime // 考试日期
  subjects    String[] // 考试科目
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 学习任务
model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime // 任务日期
  completed   Boolean  @default(false)
  duration    Int?     // 学习时长(分钟)
  phase       String?  // 所属阶段
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// 每日打卡
model CheckIn {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @unique
  duration    Int      // 学习时长(分钟)
  status      String   // 状态: good/normal/tired
  note        String?  // 备注
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// 学习资料
model Material {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   // pdf/word/image/text
  url         String   // 存储路径
  size        Int      // 文件大小(字节)
  content     String?  // 提取的文本内容
  embedding   Unsupported("vector(1536)")? // 向量嵌入
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI 对话记录
model Chat {
  id          String   @id @default(uuid())
  userId      String
  messages    Json     // 消息列表
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 学习反馈
model Feedback {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime // 周开始日期
  weekEnd     DateTime // 周结束日期
  content     String   // 反馈内容
  suggestions String[] // 建议列表
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}
