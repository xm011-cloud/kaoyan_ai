{
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60,
      "externalNodeModules": [
        ".prisma",
        "prisma",
        "@prisma/client",
        "@prisma/adapter-pg",
        "pg",
        "pg-native",
        "pg-cloudflare",
        "pg-connection-string",
        "pg-int8",
        "pg-numeric",
        "pg-protocol",
        "pg-types",
        "pgpass",
        "pdf2json",
        "@supabase/ssr",
        "@supabase/supabase-js",
        "@supabase/auth-js",
        "@supabase/functions-js",
        "@supabase/postgrest-js",
        "@supabase/realtime-js",
        "@supabase/storage-js"
      ]
    }
  }
}
