generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户表
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  aiKey     String?  // 用户自己的 AI API Key
  aiUrl     String?  // 用户自定义 API Base URL
  aiModel   String?  // 用户选择的模型
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  goal              Goal?
  tasks             Task[]
  checkIns          CheckIn[]
  materials         Material[]
  chats             Chat[]
  feedbacks         Feedback[]
  wrongQuestions    WrongQuestion[]
  practiceSessions  PracticeSession[]
}

// 考研目标
model Goal {
  id          String   @id @default(uuid())
  userId      String   @unique
  university  String   // 目标院校
  major       String   // 目标专业
  examDate    DateTime // 考试日期
  subjects    String[] // 考试科目
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 学习任务
model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime // 任务日期
  completed   Boolean  @default(false)
  duration    Int?     // 学习时长(分钟)
  phase       String?  // 所属阶段
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// 每日打卡
model CheckIn {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime // 打卡日期
  duration    Int      // 学习时长(分钟)
  status      String   // 状态: good/normal/tired
  note        String?  // 备注
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// 学习资料
model Material {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   // pdf/word/image/text
  url         String   // 存储路径
  size        Int      // 文件大小(字节)
  content     String?  // 提取的文本内容
  embedding   Unsupported("vector(1536)")? // 向量嵌入 — 需安装 pgvector 扩展
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI 对话记录
model Chat {
  id          String   @id @default(uuid())
  userId      String
  messages    Json     // 消息列表
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 学习反馈
model Feedback {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime // 周开始日期
  weekEnd     DateTime // 周结束日期
  content     String   // 反馈内容
  suggestions String[] // 建议列表
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

// 错题本
model WrongQuestion {
  id             String    @id @default(uuid())
  userId         String
  subject        String    // 科目名称
  question       String    // 题目内容
  answer         String    // 正确答案/解析
  source         String    // 来源: "chat" | "manual" | "practice"
  sourceChatId   String?   // 关联的 Chat ID
  tags           String[]  // 标签
  reviewed       Boolean   @default(false)
  reviewCount    Int       @default(0)
  nextReviewDate DateTime? // 下次复习日期
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@index([userId, reviewed])
  @@index([userId, nextReviewDate])
}

// 练习/考试会话
model PracticeSession {
  id          String    @id @default(uuid())
  userId      String
  type        String    // "daily" | "mock"
  subject     String    // 科目名称
  status      String    @default("in_progress")
  questions   Json      // 题目列表
  answers     Json      @default("{}")
  scores      Json      @default("{}")
  totalScore  Int?      // 总分
  maxScore    Int?      // 满分
  duration    Int?      // 考试时长（分钟）
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, createdAt])
}
