generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  aiKey     String?  // 用户自己的 AI API Key
  aiUrl     String?  // 用户自定义 API Base URL
  aiModel   String?  // 用户选择的模型
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 番茄钟设置
  pomodoroFocusMinutes       Int      @default(25)
  pomodoroShortBreakMinutes  Int      @default(5)
  pomodoroLongBreakMinutes   Int      @default(15)
  pomodoroLongBreakInterval  Int      @default(4)

  // 学习提醒设置
  reminderEnabled Boolean  @default(false)
  reminderTime    String?  // "HH:MM" 格式
  reminderDays    String[] // ["1","2","3","4","5"] 周一到周五

  // UI 偏好设置
  navPreferences      Json?   // 导航分组可见性偏好
  practicePreferences Json?   // 出题默认偏好

  // 关联
  goal              Goal?
  tasks             Task[]
  checkIns          CheckIn[]
  materials         Material[]
  chats             Chat[]
  feedbacks         Feedback[]
  wrongQuestions    WrongQuestion[]
  practiceSessions  PracticeSession[]
  pomodoroSessions  PomodoroSession[]
  admissionInfos    AdmissionInfo[]
  importedQuestions ImportedQuestion[]
  schoolComparisons SchoolComparison[]
  knowledgeNodes    KnowledgeNode[]
  studyPath         StudyPath?
  supporters        Supporter[]
  authorFeedbacks   AuthorFeedback[]
}

// 考研目标
model Goal {
  id          String   @id @default(uuid())
  userId      String   @unique
  university  String   // 目标院校
  major       String   // 目标专业
  examDate    DateTime // 考试日期
  subjects    String[] // 考试科目
  targetScores Json?    // 目标分数 {"政治":70, "英语":65, ...}
  progress    Json?    // 各科进度 {"数学一":{"percent":80,"note":"高数第三章"}}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 学习任务
model Task {
  id            String    @id @default(uuid())
  userId        String
  title         String
  description   String?
  date          DateTime  // 任务日期
  completed     Boolean   @default(false)
  duration      Int?      // 学习时长(分钟)
  phase         String?   // 所属阶段
  subject       String?   // 所属科目
  weekStartDate DateTime? // 所属周的开始日期
  source        String?   // "ai" | "manual"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, weekStartDate])
}

// 每日打卡
model CheckIn {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime // 打卡日期
  duration    Int      // 学习时长(分钟)
  status      String   // 状态: good/normal/tired
  note        String?  // 备注
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// 学习资料
model Material {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   // pdf/word/image/text
  url         String   // 存储路径
  size        Int      // 文件大小(字节)
  content     String?  // 提取的文本内容
  embedding   Unsupported("vector(1536)")? // 向量嵌入 — 需安装 pgvector 扩展
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI 对话记录
model Chat {
  id          String   @id @default(uuid())
  userId      String
  messages    Json     // 消息列表
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 学习反馈
model Feedback {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime // 周开始日期
  weekEnd     DateTime // 周结束日期
  content     String   // 反馈内容
  suggestions String[] // 建议列表
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

// 错题本
model WrongQuestion {
  id             String    @id @default(uuid())
  userId         String
  subject        String    // 科目名称
  question       String    // 题目内容
  answer         String    // 正确答案/解析
  source         String    // 来源: "chat" | "manual" | "practice"
  sourceChatId   String?   // 关联的 Chat ID
  tags           String[]  // 标签
  reviewed       Boolean   @default(false)
  reviewCount    Int       @default(0)
  lastReviewDate DateTime? // 上次复习日期
  easeFactor     Float     @default(2.5) // SM-2 ease factor
  interval       Int       @default(0)   // SM-2 复习间隔（天）
  nextReviewDate DateTime? // 下次复习日期
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@index([userId, reviewed])
  @@index([userId, nextReviewDate])
}

// 练习/考试会话
model PracticeSession {
  id          String    @id @default(uuid())
  userId      String
  type        String    // "daily" | "mock"
  subject     String    // 科目名称
  status      String    @default("in_progress")
  questions   Json      // 题目列表
  answers     Json      @default("{}")
  scores      Json      @default("{}")
  totalScore  Int?      // 总分
  maxScore    Int?      // 满分
  duration    Int?      // 考试时长（分钟）
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// 番茄钟会话记录
model PomodoroSession {
  id             String   @id @default(uuid())
  userId         String
  type           String   // "focus" | "short_break" | "long_break"
  plannedMinutes Int      // 计划时长（分钟）
  actualSeconds  Int      // 实际完成秒数
  status         String   @default("completed") // "completed" | "interrupted"
  startedAt      DateTime
  endedAt        DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 院校录取信息（按年份存储，数据可跨用户共享）
model AdmissionInfo {
  id         String   @id @default(uuid())
  userId     String?  // null = 系统全局数据
  university String
  major      String
  year       Int      // 数据年份
  category   String   // "score_line" | "enrollment" | "subjects" | "tuition" | "notes"
  data       Json     // 结构化数据
  source     String   // 来源 URL
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([university, major, year, category])
  @@index([university, major])
}

// 联网导入的真题
model ImportedQuestion {
  id              String   @id @default(uuid())
  userId          String
  subject         String
  year            Int      // 真题年份
  source          String   // 来源 URL
  sourceName      String?  // 来源描述
  question        String
  type            String   // "choice" | "essay"
  options         Json?    // 选择题选项
  answer          String
  explanation     String
  tags            String[]
  addedToPractice Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@index([userId, year])
}

// 院校对比记录
model SchoolComparison {
  id        String   @id @default(uuid())
  userId    String
  schools   Json     // 对比的院校列表
  analysis  String?  // AI 分析结果
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 知识图谱节点
model KnowledgeNode {
  id        String   @id @default(uuid())
  userId    String
  name      String   // 知识点名称，如 "极限"
  subject   String   // 所属科目
  category  String   @default("concept") // "concept" | "formula" | "method" | "theorem"
  weight    Float    @default(1.0) // 权重（根据错题数量等）
  mastery   Float    @default(0.0) // 掌握度 0-1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromEdges  KnowledgeEdge[] @relation("from")
  toEdges    KnowledgeEdge[] @relation("to")

  @@unique([userId, name, subject])
  @@index([userId])
}

// 知识图谱边
model KnowledgeEdge {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  relation  String   @default("related") // "prerequisite" | "related" | "extends"
  label     String?  // 边标签
  createdAt DateTime @default(now())

  from KnowledgeNode @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeNode @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// AI 学习路径
model StudyPath {
  id            String   @id @default(uuid())
  userId        String   @unique
  title         String   // 路径名称，如 "2026 考研冲刺路径"
  description   String?  // 路径描述
  subjects      String[] // 覆盖科目
  targetScores  Json?    // 目标分数
  currentScores Json?    // 当前估分
  status        String   @default("active") // "active" | "completed" | "paused"
  generatedBy   String   @default("ai") // "ai" | "manual"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones StudyPathMilestone[]
}

// 学习路径里程碑
model StudyPathMilestone {
  id          String    @id @default(uuid())
  studyPathId String
  title       String    // 里程碑标题
  description String?   // 详细描述
  phase       String    // 阶段: "基础" | "强化" | "冲刺" | "查漏补缺"
  subject     String    // 科目
  order       Int       @default(0) // 排序
  targetDate  DateTime? // 目标完成日期
  completedAt DateTime? // 实际完成日期
  progress    Float     @default(0.0) // 进度 0-1
  tips        String?   // AI 学习建议
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studyPath StudyPath @relation(fields: [studyPathId], references: [id], onDelete: Cascade)

  @@index([studyPathId, order])
}

// 支持作者 — 感谢墙留言（审核通过后才展示）
model Supporter {
  id        String   @id @default(uuid())
  userId    String? // null = 游客留言
  name      String
  amount    Float    @default(9.9)
  message   String?
  approved  Boolean  @default(false) // 作者审核后才上墙
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([approved, createdAt])
  @@index([userId])
}

// 意见反馈 — 用户给作者的评价/建议（需登录）
model AuthorFeedback {
  id        String   @id @default(uuid())
  userId    String
  rating    Int // 1-5
  content   String
  anonymous Boolean  @default(false)
  status    String   @default("new") // "new" | "read" | "resolved"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}
