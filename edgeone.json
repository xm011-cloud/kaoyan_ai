{
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60,
      "externalNodeModules": [
        ".prisma",
        "prisma",
        "@prisma/client",
        "@prisma/adapter-pg",
        "pg",
        "pg-native",
        "pdf2json",
        "d3",
        "@supabase/ssr",
        "@supabase/supabase-js"
      ]
    }
  }
}
