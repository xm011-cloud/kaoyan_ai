{
  "buildCommand": "npx prisma generate && npm run build",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": [
        "@prisma/client",
        "@prisma/adapter-pg",
        "prisma",
        "pg",
        "pg-native",
        "pg-connection-string",
        "pg-protocol",
        "pg-types",
        "pgpass",
        "postgres-array",
        "postgres-bytea",
        "postgres-date",
        "postgres-interval",
        "postgres-range"
      ]
    }
  }
}
